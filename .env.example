# Johnny 5 Companion — Beispiel-Umgebungsvariablen
#
# Kopiere diese Datei nach `.env` und passe die Werte an. `.env` wird
# **niemals** ins Repo committet (siehe .gitignore).
#
# Variablen-Namen folgen dem Pattern JOHNNY5_<SERVICE>_<FIELD>.
# Konkrete Felder siehe src/johnny5/settings/*.py.

# --- MQTT ---------------------------------------------------------------
JOHNNY5_MQTT_HOST=localhost
JOHNNY5_MQTT_PORT=1883
# Optional, leer = kein Auth
JOHNNY5_MQTT_USERNAME=
JOHNNY5_MQTT_PASSWORD=
JOHNNY5_MQTT_RECONNECT_INTERVAL_S=5.0

# --- Safety -------------------------------------------------------------
JOHNNY5_SAFETY_HEARTBEAT_INTERVAL_S=0.1
JOHNNY5_SAFETY_HEARTBEAT_TIMEOUT_S=0.5
JOHNNY5_SAFETY_MAX_MOTION_DURATION_S=5.0
JOHNNY5_SAFETY_MAX_TARGET_DISTANCE_M=3.0

# --- Perception ---------------------------------------------------------
JOHNNY5_PERCEPTION_MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.7
JOHNNY5_PERCEPTION_MEDIAPIPE_MIN_TRACKING_CONFIDENCE=0.5
JOHNNY5_PERCEPTION_PAD_UPDATE_MIN_CONFIDENCE=0.7
JOHNNY5_PERCEPTION_PAD_UPDATE_MAX_DISTANCE_M=2.0
JOHNNY5_PERCEPTION_WHISPER_MODEL_SIZE=base
JOHNNY5_PERCEPTION_WHISPER_COMPUTE_TYPE=float16
JOHNNY5_PERCEPTION_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Behavior -----------------------------------------------------------
JOHNNY5_BEHAVIOR_TICK_RATE_HZ=10.0
JOHNNY5_BEHAVIOR_REACTION_SIGNAL_TARGET_MS=250.0
JOHNNY5_BEHAVIOR_INTERRUPT_TARGET_MS=100.0
JOHNNY5_BEHAVIOR_LLM_TOKEN_BUDGET_PER_DAY=100000
JOHNNY5_BEHAVIOR_LLM_LOCAL_FIRST=true

# --- Memory (PostgreSQL + pgvector) ------------------------------------
JOHNNY5_MEMORY_PG_HOST=localhost
JOHNNY5_MEMORY_PG_PORT=5432
JOHNNY5_MEMORY_PG_DATABASE=johnny5
JOHNNY5_MEMORY_PG_USER=johnny5
# In Produktion: aus Secret-Manager / Vault, nicht in `.env`
JOHNNY5_MEMORY_PG_PASSWORD=changeme
JOHNNY5_MEMORY_DECAY_RATE_PER_HOUR=0.99
JOHNNY5_MEMORY_REFLECTION_IMPORTANCE_THRESHOLD=150.0

# --- LLM (Cloud) --------------------------------------------------------
# Werden direkt von den SDKs gelesen, nicht über Johnny5-Settings:
# ANTHROPIC_API_KEY=
# HUGGINGFACE_TOKEN=
