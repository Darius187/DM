# Root: alles auf /public umleiten (Alfahosting kann oft kein DocumentRoot ändern)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Sensitive Ordner sperren
RedirectMatch 403 ^/app/.*$
RedirectMatch 403 ^/storage/.*$
RedirectMatch 403 ^/build/.*$
RedirectMatch 403 ^/\.git.*$
RedirectMatch 403 ^/CLAUDE\.md$
RedirectMatch 403 ^/README\.md$
