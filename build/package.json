{
  "name": "unisilent-build",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build for uni-silent.de — produces public/assets/css/tailwind.min.css for SFTP upload to Alfahosting.",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i src.css -o ../public/assets/css/tailwind.min.css --minify",
    "watch": "tailwindcss -c tailwind.config.js -i src.css -o ../public/assets/css/tailwind.min.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "tailwindcss": "^3.4.0"
  }
}
