{
  "name": "schachtrainer",
  "productName": "Schachtrainer",
  "private": true,
  "version": "0.1.26",
  "description": "Lokales Schach-Trainingsprogramm mit Stockfish und deutscher Sprachausgabe.",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "copy-engine": "node scripts/copy-engine.js",
    "postinstall": "node scripts/copy-engine.js",
    "predev": "node scripts/copy-engine.js",
    "dev": "vite",
    "prebuild": "node scripts/copy-engine.js",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "pack:win": "npm run build && electron-builder --win portable --x64",
    "pack:linux": "npm run build && electron-builder --linux AppImage --x64"
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.8",
    "chessground": "^9.1.1",
    "node-edge-tts": "^1.2.10",
    "stockfish": "^18.0.7"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "de.schachtrainer.app",
    "productName": "Schachtrainer",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.cjs",
      "preload.cjs",
      "dist/index.html",
      "dist/wissen.html",
      "dist/assets/**",
      "dist/engine/**"
    ],
    "asarUnpack": [
      "dist/engine/**",
      "node_modules/node-edge-tts/**",
      "node_modules/ws/**",
      "node_modules/https-proxy-agent/**",
      "node_modules/agent-base/**",
      "node_modules/debug/**",
      "node_modules/ms/**",
      "node_modules/yargs/**",
      "node_modules/yargs-parser/**",
      "node_modules/cliui/**",
      "node_modules/escalade/**",
      "node_modules/get-caller-file/**",
      "node_modules/require-directory/**",
      "node_modules/string-width/**",
      "node_modules/strip-ansi/**",
      "node_modules/ansi-regex/**",
      "node_modules/wrap-ansi/**",
      "node_modules/ansi-styles/**",
      "node_modules/color-convert/**",
      "node_modules/color-name/**",
      "node_modules/emoji-regex/**",
      "node_modules/is-fullwidth-code-point/**",
      "node_modules/y18n/**"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Schachtrainer-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "Schachtrainer-${version}-portable.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "artifactName": "Schachtrainer-${version}.AppImage"
    }
  }
}
